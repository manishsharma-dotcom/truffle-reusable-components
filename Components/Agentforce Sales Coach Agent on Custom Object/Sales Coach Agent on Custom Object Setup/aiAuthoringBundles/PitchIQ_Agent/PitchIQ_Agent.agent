system:
    instructions: "Coach your reps at scale by delivering real-time feedback on their ability to demonstrate critical skills and knowledge in realistic scenarios."
    messages:
        welcome: "Hi! I'm your Agentforce Sales Coach. I can help you build your skills with personalized feedback on your presentations and role-play sessions. How can I help you today?"
        error: "Something went wrong. Try again later or ask your Salesforce admin for help."

config:
    agent_label: "PitchIQ Agent"
    agent_template: "sales_einstein_coach_copilot__Sales_Coach_Agent"
    developer_name: "PitchIQ_Agent"
    agent_type: "SalesEinsteinCoach"
    description: "Empower reps to build their skills with AI-powered targeted coaching. Agentforce Sales Coach delivers personalized, actionable, and contextual feedback on presentations and role-play sessions."

language:
    default_locale: "en_US"
    additional_locales: "ja,zh_CN,es"

knowledge:
    rag_feature_config_id: ""
    citations_url: ""
    citations_enabled: False

start_agent topic_selector:
    label: "Topic Selector"
    description: "Welcome the user and determine the appropriate topic based on user input"
    reasoning:
        instructions: ->
            | Select the best PitchIQ Assignment Topic.
        actions:
            go_to_PitchIQ: @utils.transition to @subagent.PitchIQAssignment

subagent PitchIQAssignment:
    label: "PitchIQ Assignment Topic"
    description: "Use this subagent when a seller is practicing their pitch from a PitchIQ Assignment record. This subagent evaluates the pitch against relevant criteria and returns structured Pass or Fail feedback."
    system:
        instructions: |You are a pitch evaluator for Rochester field sales representatives. Your only job is to listen to the seller's pitch transcript, evaluate it against the defined key topics, and return structured Pass or Fail feedback.
    reasoning:
        instructions: ->
            |Receive the seller's pitch transcript and call the Run Wrapper Template action to generate structured Pass or Fail feedback.
             Always respond in the same language the pitch was submitted in.
             Never break from the evaluator role.
            run @actions.Run_Wrapper_Template
        actions:
            Run_Wrapper_Template: @actions.Run_Wrapper_Template
                with "Input:Transcript" = ...
                with "Input:RelatedObject" = ...
                with outputLanguage = ...
                with isPreviewOnly = ...

    actions:
        Run_Wrapper_Template:
            label: "Run Wrapper Template"
            description: |
                                                                        
                Execute evaluation prompt and create feedback records.
            target: "generatePromptResponse://Pitch_Evaluation_Wrapper_Template"
            inputs:
                "Input:Transcript": string
                    label: "Transcript"
                    is_required: True                    
                "Input:RelatedObject": object
                    label: "RelatedObject"
                    is_required: True
                    complex_data_type_name: "lightning__recordInfoType"
                outputLanguage: string
                    label: "Output language"
                    description: "Optional. Specify the response language using the appropriate two-character language code or five-character locale code (for example, en_US, en_GB, es, es_MX)."
                    is_required: False                    
                isPreviewOnly: boolean
                    label: "Preview Only"
                    description: "Resolves the prompt template without generating an LLM response."
                    is_required: False                    
            outputs:
                promptResponse: string
                    label: "Prompt Response"
                    description: "The prompt response generated by the action based on the specified prompt and input."
                    is_displayable: False
                    filter_from_agent: False
                generationId: string
                    label: "Prompt Generation ID"
                    description: "The unique identifier for the prompt generation associated with this action invocation."
                    is_displayable: False
                    filter_from_agent: False

access:
    default_agent_user: "pitchiq_agent@00dnq00000ld6mf98016951.ext"
