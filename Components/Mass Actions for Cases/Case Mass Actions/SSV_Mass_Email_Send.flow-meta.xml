            </connector>
            <label>Already reached Daily limit</label>
        </rules>
        <rules>
            <name>If_Email_Limit_is_available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EmailCountBefore</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>DailyEmailLimit</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Display_Remaining_Limit</targetReference>
            </connector>
            <label>If Email Limit is available</label>
        </rules>
