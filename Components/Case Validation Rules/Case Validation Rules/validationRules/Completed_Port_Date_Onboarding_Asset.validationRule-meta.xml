<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Port_Date_Onboarding_Asset</fullName>
    <active>false</active>
    <errorConditionFormula>AND(Onboarding_Asset_Complete__c,
Software_Only__c = FALSE,
ISBLANK(Account.Completed_Port_Date__c ),
$Profile.Name = &quot;Onboarding&quot;)</errorConditionFormula>
    <errorDisplayField>of_Phones_Returned__c</errorDisplayField>
    <errorMessage>Completed Port Date Must be filled out before Onboarding Asset Complete can be checked</errorMessage>
</ValidationRule>
