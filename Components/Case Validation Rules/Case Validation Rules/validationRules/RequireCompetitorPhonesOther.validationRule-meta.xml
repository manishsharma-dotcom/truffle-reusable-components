<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireCompetitorPhonesOther</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT($Setup.ValidationSetting__c.ByPassAllValidationRules__c),
ISPICKVAL(Competitor_Phones__c  , &apos;Other&apos;),
ISCHANGED(Competitor_Phones__c),
ISBLANK(CompetitorPhonesOther__c )
)</errorConditionFormula>
    <errorDisplayField>CompetitorPhonesOther__c</errorDisplayField>
    <errorMessage>Please fill in other competitor details before closing the case.</errorMessage>
</ValidationRule>
