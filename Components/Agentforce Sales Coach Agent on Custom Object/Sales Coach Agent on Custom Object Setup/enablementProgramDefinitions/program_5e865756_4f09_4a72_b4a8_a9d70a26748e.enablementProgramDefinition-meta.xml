            <name>Using the My List Tool on RochesterElectronics.com</name>
            <sequenceNumber>10</sequenceNumber>
            <taskCategory>Exercise</taskCategory>
            <taskSubCategory>Video</taskSubCategory>
        </tasks>
    </sections>
