<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>

    <targets>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <targetConfigs>
        <!-- make it available on Case record pages -->
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Case</object>
                <!-- add other objects, or omit <objects> entirely to allow all -->
            </objects>
        </targetConfig>

        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String"
                      label="Record ID" default="{!recordId}"
                      description="Should be set to {!recordId}" />
        </targetConfig>

        <!-- if you want props on the community page as well: -->
        
    </targetConfigs>
</LightningComponentBundle>