            <exercise>
                <cmsContent>
                    <apiName>enablement/sfdcEnablement_EnablementWorkspace.sfdc_enablement__textLesson/Identifying_Customer_Signals</apiName>
                </cmsContent>
            </exercise>
            <name>Identifying Customer Signals</name>
            <sequenceNumber>8</sequenceNumber>
            <taskCategory>Exercise</taskCategory>
            <taskSubCategory>TextLesson</taskSubCategory>
        </tasks>
        <tasks>
