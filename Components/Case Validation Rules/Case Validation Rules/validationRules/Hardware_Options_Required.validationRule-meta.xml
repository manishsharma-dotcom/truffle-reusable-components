<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Hardware_Options_Required</fullName>
    <active>false</active>
    <description>https://getweave.atlassian.net/browse/SFM-7037</description>
    <errorConditionFormula>AND(
NOT($Setup.ValidationSetting__c.ByPassAllValidationRules__c),
RecordType.DeveloperName = &quot;SWAT&quot;,
ISBLANK(HardwareOptions__c),
OR(
INCLUDES(CancellationSubreasonDetails__c , &quot;Hardware&quot;),
INCLUDES(SecondaryCancellationSubreasonDetails__c, &quot;Hardware&quot;)
)
)</errorConditionFormula>
    <errorDisplayField>HardwareOptions__c</errorDisplayField>
    <errorMessage>Please provide Hardware Option</errorMessage>
</ValidationRule>
