            </connector>
            <label>Has Contact Id</label>
        </rules>
        <rules>
            <name>Has_Email_In_PreChat</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>userIdHidden</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact_By_Email</targetReference>
            </connector>
            <label>Has Email In PreChat</label>
        </rules>
    </decisions>
