<?xml version="1.0" encoding="UTF-8"?>
<EnablementMeasureDefinition xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <description>Counts the number of calls recorded by the call owner. To qualify, calls must have a talk ratio that&apos;s less than 50%. This prebuilt measure is provided to you by Salesforce. Einstein Conversation Insights must be enabled.</description>
    <developerName>salesforceTemplate_TalkListenRatio</developerName>
    <masterLabel>Number of Calls with Talk Ratio Less Than 50%</masterLabel>
    <sourceMeasureObject>
        <aggregateFunction>Count</aggregateFunction>
        <dateFieldApiName>ActivityDateTime</dateFieldApiName>
        <displayFieldApiName>Id</displayFieldApiName>
        <objectApiName xsi:nil="true"/>
        <relatedMeasureObjects>
            <filters>
                <fieldApiName>ParticipantType</fieldApiName>
                <fieldValue>From</fieldValue>
                <operator>Equals</operator>
                <sequenceNumber>1</sequenceNumber>
            </filters>
            <filters>
                <fieldApiName>TalkRatio</fieldApiName>
                <fieldValue>50</fieldValue>
                <operator>LessThanOrEqual</operator>
                <sequenceNumber>2</sequenceNumber>
            </filters>
            <filters>
                <fieldApiName>PersonId</fieldApiName>
                <fieldValue>$User</fieldValue>
                <operator>Equals</operator>
                <sequenceNumber>3</sequenceNumber>
            </filters>
            <idFieldApiName>ActivityId</idFieldApiName>
            <objectApiName xsi:nil="true"/>
        </relatedMeasureObjects>
        <userFieldApiName>Detail.OwnerId</userFieldApiName>
    </sourceMeasureObject>
    <status>Published</status>
</EnablementMeasureDefinition>
