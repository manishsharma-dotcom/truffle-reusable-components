            <day>1</day>
            <description>Every TLS360-designated part is assigned a lifecycle horizon to provide planning visibility.</description>
            <developerName>task_117c3749_54cf_4737_9d14_61b2079caff3</developerName>
            <exercise>
                <cmsContent>
                    <apiName>enablement/sfdcEnablement_EnablementWorkspace.sfdc_enablement__textLesson/Lifecycle_Planning_Under_TLS360</apiName>
                </cmsContent>
            </exercise>
            <name>Lifecycle Horizons</name>
            <sequenceNumber>5</sequenceNumber>
            <taskCategory>Exercise</taskCategory>
            <taskSubCategory>TextLesson</taskSubCategory>
        </tasks>
        <tasks>
            <day>1</day>
            <description>TLS360 uses industry-standard JEDEC lifecycle terminology and change notification practices.</description>
            <developerName>task_a016ae56_4970_4315_84ae_8e23088fe3b2</developerName>
            <exercise>
                <cmsContent>
                    <apiName>enablement/sfdcEnablement_EnablementWorkspace.sfdc_enablement__textLesson/Lifecycle_Governance</apiName>
                </cmsContent>
            </exercise>
            <name>Lifecycle Governance</name>
            <sequenceNumber>6</sequenceNumber>
            <taskCategory>Exercise</taskCategory>
            <taskSubCategory>TextLesson</taskSubCategory>
        </tasks>
    </sections>
    <sections>
