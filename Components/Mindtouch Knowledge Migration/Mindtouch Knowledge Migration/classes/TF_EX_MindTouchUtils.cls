    public static String buildUrlName(String input) {
        
        if (String.isBlank(input)) {
            return input;
        }
        input = EncodingUtil.urlDecode(input,'UTF-8');
        // Step 1: Replace all special characters with '-'
        // Keeps only letters and numbers
        String result = input.replaceAll('[^a-zA-Z0-9]', '-');
        
        // Step 2: Replace multiple consecutive '-' with single '-'
        result = result.replaceAll('-+', '-');
        
        // Step 3: Remove leading and trailing '-'
        result = result.replaceAll('^-+', '');
        result = result.replaceAll('-+$', '');
        if(result.length() > 255){
            result = result.subString(0,255);
        }
        return result;
    }
    
    // Add this to MindTouchUtils — publish batch is too big for inline doc
    public static void publishAllArticles() {
        List<Knowledge__kav> drafts = [
            SELECT KnowledgeArticleId
            FROM Knowledge__kav
            WHERE PublishStatus = 'Draft'
        ];
        for (Knowledge__kav kav : drafts) {
            KbManagement.PublishingService.publishArticle(
                kav.KnowledgeArticleId, false
            );
        }
        System.debug('Published: ' + drafts.size() + ' articles');
    }
    
    // Add this to MindTouchUtils — post migration summary
    public static void postMigrationSummary() {
        Integer kavOnline  = [SELECT COUNT() FROM Knowledge__kav WHERE PublishStatus = 'Online'];
        Integer kavDraft   = [SELECT COUNT() FROM Knowledge__kav WHERE PublishStatus = 'Draft'];
        Integer totalImages= [SELECT COUNT() FROM ContentVersion WHERE IsLatest = true AND FileExtension = 'png'];
        Integer totalDists = [SELECT COUNT() FROM ContentDistribution];
        Integer dataCategs = [SELECT COUNT() FROM Knowledge__DataCategorySelection];
        
        System.debug('=== POST-MIGRATION SUMMARY ===');
        System.debug('Knowledge articles (Published): ' + kavOnline);
        System.debug('Knowledge articles (Draft):     ' + kavDraft);
        System.debug('PNG images uploaded:            ' + totalImages);
        System.debug('Public URLs (ContentDist):      ' + totalDists);
        System.debug('DataCategorySelections:         ' + dataCategs);
    }
    
    public static Integer validateURL(String input){
        
        MindTouch_Config__mdt config = [
            SELECT SiteURL__c,matchingPattern__c
            FROM MindTouch_Config__mdt where SiteURL__c != NULL and matchingPattern__c != NULL
            LIMIT 1
        ];

        String siteURL    = config.SiteURL__c;       
        String matchingPattern = config.matchingPattern__c;
        // Regex to capture full URL (until space, comma, or end)
        //Pattern pattern = Pattern.compile(baseUrl + '[^\\s,]*');
        Pattern pattern = Pattern.compile(matchingPattern);
        Matcher matcher = pattern.matcher(input);
        Integer counter = 0;
        while (matcher.find()) {
            
            String fullUrl = matcher.group();
            
            // Extract part AFTER base URL
            String remaining = fullUrl.replaceFirst(siteURL, '');
            
            Boolean hasExtraSlash = remaining.contains('/');
            Boolean hasUnderscore = remaining.contains('_');
            if(hasExtraSlash || hasUnderscore){
                counter++;
                System.debug('Full URL: ' + fullUrl);
                System.debug('Remaining Part: ' + remaining);
                System.debug('Has extra / : ' + hasExtraSlash);
                System.debug('Has _ : ' + hasUnderscore);
                System.debug('---------------------------');
            }
        }
        system.debug('counter--->' + counter);
        return counter;
    }
    
    public static void getNewDataCategory(){
        List<KnowledgeCategoryMap__c> records = [SELECT Id, Id__c, ArticleType__c, Title__c,New_Category__c,Parent__c, Parent__r.Title__c, Processed__c,MindTouchPath__c, Public__c FROM KnowledgeCategoryMap__c];
        
        List<Data_Category_Mapping__c> categMapping = [SELECT id, Old_Category__c, New_Category__c FROM Data_Category_Mapping__c];
        Map<String,String> oldToNewCateg = new Map<String,String>();
        for(Data_Category_Mapping__c each : categMapping){
            oldToNewCateg.put(each.Old_Category__c,each.New_Category__c);
        }
        
        for(KnowledgeCategoryMap__c each : records){
            if(oldToNewCateg != null && oldToNewCateg.containsKey(each.articleType__c)){
                each.New_Category__c = oldToNewCateg.get(each.articleType__c);
            }
        }
        update records;
    }
    
    public static void getCurrentCategory(){
        List<KnowledgeCategoryMap__c> records = [SELECT Id,Processed__c,ArticleType__c,MindTouchPath__c FROM KnowledgeCategoryMap__c WHERE ArticleType__c IN ('topic','howto','reference','videos')];
        for(KnowledgeCategoryMap__c each : records){
            String lastPart = each.MindTouchPath__c.substringAfterLast('/');
            String updatedPath = each.MindTouchPath__c.replace(lastPart,'');
            updatedPath = updatedPath.removeEnd('/');
            String DataCateg = updatedPath.substringAfterLast('/');
            each.current_category__c = dataCateg;
        }
        update records;
    }
    
    public static Integer checkSummaryField(){
        Integer counter = 0;
        List<KnowledgeCategoryMap__c> records = [SELECT Id,Processed__c,ArticleType__c,MindTouchPath__c,summary__c FROM KnowledgeCategoryMap__c WHERE ArticleType__c IN ('topic','howto','reference','videos')];
        for(KnowledgeCategoryMap__c each : records){
            if(each.summary__c == null || each.summary__c == ''){
                counter++;
            }
        }
        return counter;
    }
    
    public static void updateURLName(){
        List<Data_Category_Mapping__c> records = [select id,title__c, URL_Name__c from Data_Category_Mapping__c ];
        for(Data_Category_Mapping__c each : records){
            if(each.title__c != null && each.title__c != ''){
                each.URL_Name__c = buildUrlName(each.title__c);
            }
        }
        update records;
    }
    
    public static String normalizeSpaces(String input) {
        if (String.isBlank(input)) {
            return input;
        }
        
        // Replace one or more spaces with a single space
        String result = input.replaceAll(' +', ' ');
        
        return result;
    }
