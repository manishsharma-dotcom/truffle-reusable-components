        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Output.Prompt</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Here is the Detail of Current File -
Title of File : {!Call_Prompt_Template_to_Read_the_File.Title}
Content of File :  {!Pass_Current_Content_Document.promptResponse}
</stringValue>
            </value>
        </assignmentItems>
