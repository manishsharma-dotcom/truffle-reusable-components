        <connector>
            <targetReference>Call_Prompt_Template_to_Read_the_File</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>Collect_Content_Document_Ids</elementReference>
            </value>
        </filters>
        <filters>
            <field>Title</field>
