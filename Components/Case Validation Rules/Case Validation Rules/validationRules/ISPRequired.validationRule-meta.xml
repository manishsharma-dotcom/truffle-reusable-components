<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ISPRequired</fullName>
    <active>false</active>
    <description>https://getweave.atlassian.net/browse/SFM-7037</description>
    <errorConditionFormula>AND(
 NOT($Setup.ValidationSetting__c.ByPassAllValidationRules__c),
 RecordType.DeveloperName = &quot;SWAT&quot;,
 ISBLANK(TEXT(ISP__c )), 
 OR(
 INCLUDES(CancellationSubreasonDetails__c , &quot;ISP&quot;),
 INCLUDES(SecondaryCancellationSubreasonDetails__c, &quot;ISP&quot;)
)
)</errorConditionFormula>
    <errorDisplayField>ISP__c</errorDisplayField>
    <errorMessage>Please select a value in the ISP field.</errorMessage>
</ValidationRule>
