<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Network_Followup_Needed</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL( Network_Follow_up_Needed__c, &quot;Yes&quot;), 
RecordTypeId = &quot;012o0000000uCZa&quot;,
Recommended_Follow_up__c = &quot;&quot;,
OR($Profile.Name = &quot;Onboarding&quot;,
$Profile.Name = &quot;Installation&quot;))</errorConditionFormula>
    <errorMessage>Fill out Recommend Follow-up</errorMessage>
</ValidationRule>
