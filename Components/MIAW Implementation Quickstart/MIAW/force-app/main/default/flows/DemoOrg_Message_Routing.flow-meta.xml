    <decisions>
        <description>This example decision node looks at the Contact that is messaging and decides which Queue they should be routed to. Here, it checks both the name and country of the customer.</description>
        <name>Has_ContactId</name>
        <label>Has ContactId</label>
        <locationX>842</locationX>
        <locationY>650</locationY>
        <defaultConnector>
            <targetReference>Assign_Pre_Chat_for_Non_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>All Other Customers</defaultConnectorLabel>
        <rules>
            <name>Customer_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContactIdLocal</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>set_Contact_In_Messaging_User</targetReference>
            </connector>
            <label>Customer Exist</label>
        </rules>
        <rules>
            <name>No_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContactIdLocal</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Pre_Chat_for_Non_Contact</targetReference>
            </connector>
            <label>No Contact</label>
        </rules>
    </decisions>
