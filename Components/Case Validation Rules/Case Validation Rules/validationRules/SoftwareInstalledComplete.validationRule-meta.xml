<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SoftwareInstalledComplete</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
NOT($Setup.ValidationSetting__c.ByPassAllValidationRules__c),
ISCHANGED(Status),
ISPICKVAL(Status, &apos;Closed&apos;),
RecordType.DeveloperName = &apos;NationwideInstall&apos;
)</errorConditionFormula>
    <errorDisplayField>SoftwareInstalled__c</errorDisplayField>
    <errorMessage>Software Installed must be completed before marking a case as closed</errorMessage>
</ValidationRule>
