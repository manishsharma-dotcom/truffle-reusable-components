<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireNativePMS</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
NOT($Setup.ValidationSetting__c.ByPassAllValidationRules__c),
ISPICKVAL(Competitor_Software__c , &apos;Native PMS&apos;),
ISCHANGED(Competitor_Software__c),
ISBLANK(NativePMS__c )
)</errorConditionFormula>
    <errorDisplayField>NativePMS__c</errorDisplayField>
    <errorMessage>Native PMS required upon the selection of Native PMS from the Competitor Software</errorMessage>
</ValidationRule>
