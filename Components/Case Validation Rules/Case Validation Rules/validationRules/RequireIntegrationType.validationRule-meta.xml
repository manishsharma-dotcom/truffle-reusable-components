<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RequireIntegrationType</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
NOT($Setup.ValidationSetting__c.ByPassAllValidationRules__c),
ISCHANGED(SoftwareInstalled__c),
ISBLANK(TEXT(IntegrationType__c)),
RecordType.DeveloperName = &apos;NationwideInstall&apos;
)</errorConditionFormula>
    <errorDisplayField>IntegrationType__c</errorDisplayField>
    <errorMessage>Integration Type must be populated before checking Software Installed</errorMessage>
</ValidationRule>
