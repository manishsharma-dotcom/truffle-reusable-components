<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_ISP_Required</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
NOT($Setup.ValidationSetting__c.ByPassAllValidationRules__c),
ISPICKVAL( ISP__c , &quot;Other&quot;),
ISCHANGED(ISP__c),
ISBLANK(OtherISP__c )
)</errorConditionFormula>
    <errorDisplayField>OtherISP__c</errorDisplayField>
    <errorMessage>Please provide ISP name</errorMessage>
</ValidationRule>
