    <decisions>
        <name>Case_Record_Type_Check</name>
        <label>Case Record Type Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Customer_Support</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Details.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SSV_CustomerSupportEmergencyAfterHours</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Details.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SSV_CustomerSupport</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Case_Details.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SSV_OwnershipTransfer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Issue_Description</targetReference>
            </connector>
            <label>Customer Support</label>
        </rules>
    </decisions>
