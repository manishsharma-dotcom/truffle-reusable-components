<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_ADI_RF_Program_Name</name>
        <label>Set ADI RF Program Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varProgramShortName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>ADI RF</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_All_Sections_of_Program</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_TLS360_Program_Name</name>
        <label>Set TLS360 Program Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varProgramShortName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>TLS360</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_All_Sections_of_Program</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Assignment_Already_Exists</name>
        <label>Assignment Already Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_PitchIQ_Assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No - Create</defaultConnectorLabel>
        <rules>
            <name>Yes_Skip</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingAssignment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Yes - Skip</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Program</name>
        <label>Check Program</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Other Program</defaultConnectorLabel>
        <rules>
            <name>TLS360</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varEnablementProgram.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>TLS360</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_TLS360_Program_Name</targetReference>
            </connector>
            <label>TLS360</label>
        </rules>
        <rules>
            <name>ADI_RF</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varEnablementProgram.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>ADI RF</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_ADI_RF_Program_Name</targetReference>
            </connector>
            <label>ADI RF</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Running_User</name>
        <label>Check Running User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_New_Assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Different User</defaultConnectorLabel>
        <rules>
            <name>Same_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$User.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AssigeeId</elementReference>
                </rightValue>
            </conditions>
            <label>Same User</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_PitchIQ_Section</name>
        <label>Has PitchIQ Section?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_All_Sections_of_Program.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Existing_PitchIQ_Assignment</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Creates a PitchIQ Assignment when a seller is enrolled in TLS360 or ADI RF enablement program. Triggered on LearningItemAssignment creation. Prevents duplicate records.</description>
    <environments>Default</environments>
    <formulas>
        <name>AssigeeId</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.AssigneeId}, 15)</expression>
    </formulas>
    <interviewLabel>PitchIQ Assignment Auto-Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PitchIQ Assignment Auto-Creation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_PitchIQ_Assignment</name>
        <label>Create PitchIQ Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Running_User</targetReference>
        </connector>
        <inputAssignments>
            <field>Enablement_Program__c</field>
            <value>
                <elementReference>varProgramShortName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Seller_User__c</field>
            <value>
                <elementReference>$Record.AssigneeId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <object>PitchIQ_Assignment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_PitchIQ_Assignment_Share</name>
        <label>Create PitchIQ Assignment Share</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AccessLevel</field>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ParentId</field>
            <value>
                <elementReference>Get_New_Assignment.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RowCause</field>
            <value>
                <stringValue>Manual</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UserOrGroupId</field>
            <value>
                <elementReference>$Record.AssigneeId</elementReference>
            </value>
        </inputAssignments>
        <object>PitchIQ_Assignment__Share</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Check_Existing_PitchIQ_Assignment</name>
        <label>Check Existing PitchIQ Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assignment_Already_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Seller_User__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AssigneeId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Enablement_Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varProgramShortName</elementReference>
            </value>
        </filters>
        <object>PitchIQ_Assignment__c</object>
        <outputReference>varExistingAssignment</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Seller_User__c</queriedFields>
        <queriedFields>Enablement_Program__c</queriedFields>
        <queriedFields>Status__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_All_Sections_of_Program</name>
        <label>Get All Sections of Program</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_PitchIQ_Section</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EnablementProgramId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varEnablementProgram.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <stringValue>PitchIQ</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EnblProgramSection</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Enablement_Program</name>
        <label>Get Enablement Program</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Program</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varLearningItem.EnablementProgramId</elementReference>
            </value>
        </filters>
        <object>EnablementProgram</object>
        <outputReference>varEnablementProgram</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Type</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Learning_Item</name>
        <label>Get Learning Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Enablement_Program</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.LearningItemId</elementReference>
            </value>
        </filters>
        <object>LearningItem</object>
        <outputReference>varLearningItem</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>EnablementProgramId</queriedFields>
        <queriedFields>Type</queriedFields>
        <queriedFields>StandardCustomLearningItemType</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_New_Assignment</name>
        <label>Get New Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_PitchIQ_Assignment_Share</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Create_PitchIQ_Assignment.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>PitchIQ_Assignment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Learning_Item</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AssigneeId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>LearningItemAssignment</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varEnablementProgram</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>EnablementProgram</objectType>
    </variables>
    <variables>
        <name>varExistingAssignment</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>PitchIQ_Assignment__c</objectType>
    </variables>
    <variables>
        <name>varLearningItem</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>LearningItem</objectType>
    </variables>
    <variables>
        <name>varProgramShortName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
