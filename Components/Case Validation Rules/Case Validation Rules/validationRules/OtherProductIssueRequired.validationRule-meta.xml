<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>OtherProductIssueRequired</fullName>
    <active>false</active>
    <description>https://getweave.atlassian.net/browse/SFM-6302</description>
    <errorConditionFormula>AND(
NOT($Setup.ValidationSetting__c.ByPassAllValidationRules__c),
IF(INCLUDES( ProductIssues__c , &quot;Other&quot;),True,False),
ISBLANK( OtherProductIssue__c)
)</errorConditionFormula>
    <errorDisplayField>ProductIssues__c</errorDisplayField>
    <errorMessage>Please Enter a product issue.</errorMessage>
</ValidationRule>
