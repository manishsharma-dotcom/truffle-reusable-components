    <masterLabel>TLS360 Foundations: Lifecycle Assurance Without Compromise - Inside Sales</masterLabel>
    <name>TLS360 Foundations: Lifecycle Assurance Without Compromise - Inside Sales</name>
    <sections>
        <developerName>section_ac50fde7_dd47_44ad_88df_a5f1b355f93c</developerName>
        <name>Understanding TLS360</name>
        <sequenceNumber>0</sequenceNumber>
        <tasks>
            <day>1</day>
            <description>Executive introduction from Colin Strother. Learn why lifecycle assurance matters for customers in long-life industries and how TLS360 helps address lifecycle risk, continuity challenges, and long-term planning requirements.</description>
            <developerName>task_b572b721_e7c3_4be8_9987_0ce4ccb66291</developerName>
            <exercise>
                <cmsContent>
                    <apiName>enablement/sfdcEnablement_EnablementWorkspace.sfdc_enablement__link/Why_TLS_Assurance_Matters_draft_excvideo</apiName>
                </cmsContent>
            </exercise>
            <name>Why Lifecycle Assurance Matters</name>
            <sequenceNumber>1</sequenceNumber>
            <taskCategory>Exercise</taskCategory>
            <taskSubCategory>OtherExercise</taskSubCategory>
        </tasks>
        <tasks>
            <day>1</day>
            <description>Understand what TLS360 is, why it exists, and how it differs from traditional lifecycle support.</description>
            <developerName>task_c6cf77aa_4c99_420c_9f58_10a9d3a30207</developerName>
            <exercise>
                <cmsContent>
                    <apiName>enablement/sfdcEnablement_EnablementWorkspace.sfdc_enablement__textLesson/TLS360_Fundamentals</apiName>
                </cmsContent>
            </exercise>
            <name>TLS360 Fundamentals</name>
            <sequenceNumber>2</sequenceNumber>
            <taskCategory>Exercise</taskCategory>
            <taskSubCategory>TextLesson</taskSubCategory>
        </tasks>
        <tasks>
            <day>1</day>
            <description>Review the TLS360 brochure for additional details regarding lifecycle governance, lifecycle horizons, and program guidance. Download for future reference and use.</description>
            <developerName>task_abaa9222_a58c_4624_80f9_280bb797c62f</developerName>
            <exercise>
                <cmsContent>
                    <apiName>enablement/sfdcEnablement_EnablementWorkspace.sfdc_enablement__link/TLS360_Program_Overview_Brochure</apiName>
                </cmsContent>
            </exercise>
            <name>TLS360 Program Overview Brochure</name>
            <sequenceNumber>3</sequenceNumber>
            <taskCategory>Exercise</taskCategory>
            <taskSubCategory>OtherExercise</taskSubCategory>
        </tasks>
    </sections>
    <sections>
        <developerName>section_8a25ba50_3f2a_4451_9923_09d1010a70c4</developerName>
        <name>Lifecycle Planning &amp; Customer Positioning</name>
        <sequenceNumber>4</sequenceNumber>
