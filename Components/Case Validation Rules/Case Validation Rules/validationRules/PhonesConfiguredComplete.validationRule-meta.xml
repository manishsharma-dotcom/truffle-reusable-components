<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PhonesConfiguredComplete</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
NOT($Setup.ValidationSetting__c.ByPassAllValidationRules__c),
ISCHANGED(Status),
ISPICKVAL(Status, &quot;Closed&quot;),
RecordType.DeveloperName = &quot;NationwideInstall&quot;,
NOT(CONTAINS(TEXT(Account.Product_Bundle__c), &quot;Software Only&quot;))
)</errorConditionFormula>
    <errorDisplayField>PhonesConfigured__c</errorDisplayField>
    <errorMessage>Phones Configured must be completed before marking a case as closed.</errorMessage>
</ValidationRule>
